(() => {
  function readQuestion() {
    const qEl = document.querySelector(".que .qtext");
    if (!qEl) return null;

    const question = qEl.innerText.trim();
    const optionEls = Array.from(document.querySelectorAll(".que .answer > div"));
    const options = optionEls
      .map((el) => el.innerText.trim())
      .filter(Boolean);

    return { question, options, optionEls };
  }

  AutoMcGraw.jblearningQuestions = { readQuestion };
})();
