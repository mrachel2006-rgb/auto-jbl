(() => {
  function applyAnswer(answerText, optionEls) {
    if (!answerText || !optionEls?.length) return false;
    const normalized = answerText.trim().toLowerCase();

    const match = optionEls.find((el) =>
      el.innerText.trim().toLowerCase().includes(normalized)
    );
    if (!match) return false;

    const input = match.querySelector("input[type='radio'], input[type='checkbox']");
    if (input) {
      input.click();
      return true;
    }
    return false;
  }

  function clickNext() {
    const nextBtn = document.querySelector("input.mod_quiz-next-nav, button.mod_quiz-next-nav");
    if (nextBtn) nextBtn.click();
  }

  AutoMcGraw.jblearningAnswers = { applyAnswer, clickNext };
})();
